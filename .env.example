# Discord Bot Token (Required for automatic bot connection on startup)
# Obtain from https://discord.com/developers/applications -> Bot -> Reset Token
# Ensure "Server Members Intent" and "Message Content Intent" are enabled under Privileged Gateway Intents.
DISCORD_TOKEN="YOUR_DISCORD_BOT_TOKEN"

# ==============================================================================
# Twilio Verify (WhatsApp OTP Phone Verification)
# ==============================================================================
# Real WhatsApp OTP delivery is powered by Twilio Verify v2.
# 1. Create an account at https://console.twilio.com
# 2. In Twilio Console, find your Account SID and Auth Token under Project Info.
# 3. Navigate to Explore Products -> Verify -> Services -> Create Service (e.g. "FFA-Glacier-Verify").
# 4. Under Service Settings -> Channels, ensure WhatsApp delivery is toggled ON.
# 5. For testing in sandbox: join the Twilio WhatsApp Sandbox (send "join <code>" to sandbox number).
# 6. For production: register an approved WhatsApp Business Profile sender or Twilio WhatsApp Verify Sender.
TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
TWILIO_VERIFY_SERVICE_SID="VAXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# Optional HTTP Server Configuration (automatically defaults to PORT=3000 and HOST=0.0.0.0)
# PORT=3000
# HOST=0.0.0.0
# NODE_ENV=production

# Optional: Custom path for persistent tournament state JSON file
# Defaults to ./.tournament-state.json in the project root.
# When deploying on Docker, Railway, or Render with a persistent volume mounted at /data, set:
# STATE_FILE_PATH="/data/.tournament-state.json"
